ICARUS_DATA_DIR=.data
# CockroachDB publication and server-only Lite reader connections.
# ICARUS_LITE_DATABASE_URL is publisher/admin-only and must never be deployed to the app.
ICARUS_LITE_DATABASE_URL=
ICARUS_LITE_READ_DATABASE_URL=
# Supabase data adapter and authentication.
# See SUPABASE_OPERATIONS.md. Only the URL and publishable key are browser-safe.
# Never add a service-role key or secret API key to a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Development-only convenience. Ignored whenever NODE_ENV is not development.
ICARUS_LOCAL_AUTH_BYPASS=false
ICARUS_LOCAL_AUTH_EMAIL=
ICARUS_LOCAL_AUTH_PASSWORD=

# Vercel Blob or equivalent object-storage adapter
BLOB_READ_WRITE_TOKEN=

# Server-only LlamaParse v2 document intelligence. Never prefix this key with NEXT_PUBLIC_.
LLAMA_CLOUD_API_KEY=
# Pinned by default for reproducible court-packet parsing; change deliberately.
LLAMAPARSE_VERSION=2026-07-24
