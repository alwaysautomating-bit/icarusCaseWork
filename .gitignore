# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/output/
/tmp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local evidence database and object store
/.data/

# local transcript intake queue and legacy working copies
/transcripts/*
!/transcripts/inbox/
!/transcripts/manifests/
!/transcripts/preserved/
!/transcripts/first-pass/
!/transcripts/README.md
!/transcripts/trial-index/
!/transcripts/archive/
/transcripts/archive/*
!/transcripts/archive/README.md
!/transcripts/archive/experiments/
/transcripts/archive/experiments/*
!/transcripts/archive/experiments/README.md
/transcripts/inbox/*
!/transcripts/inbox/.gitkeep

# extracted design-system working copy; the source archive is retained
/Icarus design system/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
