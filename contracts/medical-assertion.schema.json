{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^meda_[a-z0-9-]+_\\d{3}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "medication",
        "symptom",
        "diagnosis",
        "encounter",
        "instruction",
        "observation",
        "referral"
      ]
    },
    "raw": {
      "type": "string",
      "minLength": 1
    },
    "med": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dose": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "dose_raw": {
          "type": "string"
        },
        "frequency": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "prescriber": {
          "type": "string"
        },
        "quantity": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "start",
            "increase",
            "decrease",
            "taper",
            "discontinue",
            "hold",
            "switch",
            "continue",
            "restart",
            "discuss"
          ]
        },
        "from": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        "to": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "act": {
      "type": "string",
      "enum": [
        "prescribed",
        "ordered",
        "recommended",
        "advised",
        "instructed",
        "administered",
        "dispensed",
        "observed",
        "discussed",
        "referred"
      ]
    },
    "report": {
      "type": "string",
      "enum": [
        "patient_reported_taking",
        "patient_reported_not_taking",
        "patient_reported_stopping",
        "patient_reported_past_use",
        "patient_reported_prescribed",
        "patient_reported_intent",
        "third_party_reported",
        "recorded_on_medication_list",
        "detected_by_toxicology"
      ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "provider",
            "patient",
            "third_party",
            "unknown"
          ]
        }
      },
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false
    },
    "symptom": {
      "type": "object",
      "properties": {
        "terms": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severity": {
          "type": "string"
        },
        "trajectory": {
          "type": "string"
        }
      },
      "required": [
        "terms"
      ],
      "additionalProperties": false
    },
    "diagnosis": {
      "type": "object",
      "properties": {
        "term": {
          "type": "string"
        }
      },
      "required": [
        "term"
      ],
      "additionalProperties": false
    },
    "encounter": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "modality": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "properties": {
        "date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "type": "string",
          "enum": [
            "exact",
            "approximate",
            "range",
            "relative",
            "unknown"
          ]
        },
        "anchor": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "raw": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "precision"
      ],
      "additionalProperties": false
    },
    "basis": {
      "type": "string",
      "enum": [
        "firsthand_provider",
        "patient_statement_to_witness",
        "record_read_by_witness",
        "counsel_proposition_affirmed",
        "third_party_report",
        "witness_general_knowledge"
      ]
    },
    "status": {
      "default": "asserted",
      "type": "string",
      "enum": [
        "asserted",
        "uncertain",
        "negated",
        "hypothetical"
      ]
    },
    "temporality": {
      "default": "current",
      "type": "string",
      "enum": [
        "current",
        "historical",
        "hypothetical"
      ]
    },
    "experiencer": {
      "default": "patient",
      "type": "string",
      "enum": [
        "patient",
        "family_member",
        "other"
      ]
    },
    "evidence": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seg": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "span": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "seg",
          "span"
        ],
        "additionalProperties": false
      }
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "raw",
    "time",
    "basis",
    "status",
    "temporality",
    "experiencer",
    "evidence"
  ],
  "additionalProperties": false
}
